# Copy to ai-service/.env. Do not commit .env.

# pgvector (same Postgres container as the backend) or memory
VECTOR_STORE=pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=finintel
POSTGRES_USER=finintel
POSTGRES_PASSWORD=finintel

# Offline defaults: no API key, no model download
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-v1
EMBEDDING_DIM=512
LLM_PROVIDER=extractive

# Optional: any OpenAI-compatible API. Example for local Ollama:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768
# LLM_PROVIDER=openai
# LLM_MODEL=llama3.1:8b
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30

TOP_K=5
MIN_SCORE=0.15
CHUNK_MAX_CHARS=800

# text or json
LOG_FORMAT=text
