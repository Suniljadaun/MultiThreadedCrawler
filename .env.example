# Copy to .env and fill in. Do not commit .env.

# Postgres (host port 5433, see docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=finintel
POSTGRES_USER=finintel
POSTGRES_PASSWORD=finintel

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
